# Server
PORT=4000
NODE_ENV=development

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# DynamoDB table names
DYNAMODB_TOOLS_TABLE=apkaai-tools
DYNAMODB_CATEGORIES_TABLE=apkaai-categories
DYNAMODB_CONTACTS_TABLE=apkaai-contacts

# Frontend origin (CORS + reset-password link base URL)
FRONTEND_URL=https://apkaai.com

# PostgreSQL (used for users / auth)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apkaai
DB_USER=apkaai_user
DB_PASS=your_db_password_here
DB_SSL=false

# Auth
JWT_SECRET=your_jwt_secret_here_change_in_production
PASSWORD_SALT=your_password_salt_here_change_in_production

# Email — SMTP (used for password reset emails)
# Works with Gmail, SendGrid SMTP, AWS SES SMTP, Mailgun, etc.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
#   Use an App Password (not your Gmail password) if 2FA is enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=ApkaAI <your_email@gmail.com>
